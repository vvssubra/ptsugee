# Public Sanity read configuration. The write token is used only by
# `pnpm sanity:seed --write` and must never use a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2026-09-13
SANITY_REVALIDATE_SECRET=
SANITY_WRITE_TOKEN=

# Required when the contact form is implemented.
RESEND_API_KEY=
